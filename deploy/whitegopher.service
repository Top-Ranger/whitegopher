[Unit]
Description=whitegopher CalDAV/CardDAV server
Documentation=https://github.com/Top-Ranger/whitegopher
After=network-online.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=whitegopher
Group=whitegopher
EnvironmentFile=/etc/whitegopher/whitegopher.env
ExecStart=/usr/local/bin/whitegopher -config /etc/whitegopher/config.yaml serve
Restart=on-failure
RestartSec=3
# whitegopher drains in-flight requests for up to 15 s on SIGTERM.
TimeoutStopSec=20

# The service only reads its config and talks to the network; lock the rest down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
